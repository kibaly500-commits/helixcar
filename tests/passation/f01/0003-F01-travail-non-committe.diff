+// ── LOT F01 (F01-035/036, décision C01) — PLAFONDS DE SAISIE ─────────
+// « Mission » (Technicien) : 166 caractères ; « Type de mission »
+// (Renfort) : 156 caractères. Espaces, virgules et accents comptent
+// pour un caractère chacun : c'est la longueur JavaScript du texte, la
+// même que char_length() côté serveur (migration 111). Les deux
+// chaînes de référence font EXACTEMENT 166 et 156 caractères.
+var PRO_PLAFOND_DESCRIPTION = { mission: 166, type_mission: 156 };
+function _proPlafondDescription() {
+  return (_proCategorie() === 'renfort') ? PRO_PLAFOND_DESCRIPTION.type_mission
+                                          : PRO_PLAFOND_DESCRIPTION.mission;
+}
+// Longueur RÉELLE du texte saisi (sans le trim : les espaces comptent).
+function _proLongueurDescription() {
+  return ((document.getElementById('pro-description') || {}).value || '').length;
+}
+function _proDescriptionTropLongue() {
+  return _proLongueurDescription() > _proPlafondDescription();
+}
+function _proMessagePlafond() {
+  var max = _proPlafondDescription(), n = _proLongueurDescription();
+  return 'Limite de ' + max + ' caractères, espaces et accents compris (' + n + ' saisis) : raccourcissez le texte.';
+}
+// Le maxlength et le compteur suivent la catégorie choisie. Un texte
+// restauré d'un brouillon n'est JAMAIS tronqué : le compteur passe en
+// rouge et la validation refuse la soumission tant qu'il dépasse.
+function _proMajPlafondDescription() {
+  var el = document.getElementById('pro-description');
+  if (!el) return;
+  var max = _proPlafondDescription();
+  el.setAttribute('maxlength', String(max));
+  var cpt = document.getElementById('pro-description-compteur');
+  if (cpt) {
+    var n = _proLongueurDescription();
+    cpt.textContent = n + ' / ' + max + ' caractères';
+    cpt.classList.toggle('hc-compteur--depasse', n > max);
+  }
+}
+function proOnDescriptionInput() {
+  _proMajPlafondDescription();
+  if (!_proDescriptionTropLongue()) _clearFieldError('pro-description');
+  else _showFieldError('pro-description', _proMessagePlafond());
+  _proMajBoutonContinuer();
+}
+// Collage : le navigateur applique le maxlength (le texte collé est
+// ramené à la limite). Ce n'est jamais silencieux — le client en est
+// informé par le même message discret, sous le champ.
+function proOnDescriptionColle(e) {
+  var el = document.getElementById('pro-description');
+  if (!el) return;
+  var colle = '';
+  try { colle = (e && e.clipboardData) ? (e.clipboardData.getData('text') || '') : ''; } catch (err) { colle = ''; }
+  var max = _proPlafondDescription();
+  var selection = Math.max(0, (el.selectionEnd || 0) - (el.selectionStart || 0));
+  var attendu = (el.value || '').length - selection + colle.length;
+  setTimeout(function () {
+    _proMajPlafondDescription();
+    if (attendu > max) {
+      _showFieldError('pro-description',
+        'Texte collé raccourci à ' + max + ' caractères, espaces et accents compris (' + attendu + ' collés) : vérifiez votre saisie.');
+    }
+    _proMajBoutonContinuer();
+  }, 0);
+}
