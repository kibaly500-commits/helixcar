+// LOT F01 (F01-010/011) — L'OPTION DE SERVICE ELLE-MEME EST RESERVEE.
+// Un particulier voit « Nettoyage automobile professionnel » grisé,
+// avec « Réservé aux entreprises », et ne peut pas le cocher : le bouton
+// radio est reellement desactive (souris, clavier, tactile). Si le
+// statut redevient « Particulier » alors que ce service etait choisi,
+// le choix est retire et la progression revient a l'etape du service :
+// aucune demande de nettoyage ne peut plus partir d'un particulier —
+// et le serveur applique la meme regle (migration 111).
+// Appelee a chaque changement de type de client, a chaque rendu
+// d'etape (reinitialisation, brouillon, espace client integre) : une
+// seule source de verite, #client-type.
+function nettSyncOptionService() {
+  var opt = document.querySelector('#modal-client input[name="type-service"][value="nettoyage"]');
+  if (!opt) return;
+  var pro = _nettEstProfessionnel();
+  opt.disabled = !pro;
+  opt.setAttribute('aria-disabled', pro ? 'false' : 'true');
+  var lab = opt.closest('label');
+  if (lab) {
+    lab.classList.toggle('hc-opt-reservee', !pro);
+    lab.setAttribute('aria-disabled', pro ? 'false' : 'true');
+    if (!pro) lab.setAttribute('title', 'Réservé aux entreprises'); else lab.removeAttribute('title');
+  }
+  if (!pro && opt.checked) {
+    opt.checked = false;
+    lab && lab.classList.remove('selected');
+    // Plus aucun service choisi : les etapes au-dela du choix du service
+    // ne sont plus atteintes, et l'etape courante y revient.
+    _etapeMax = Math.min(_etapeMax, 2);
+    if (_formStepState.client > 2) _formStepState.client = 2;
+    if (typeof onChoixService === 'function') onChoixService();
+  }
+}
